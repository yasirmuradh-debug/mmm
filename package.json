{
  "name": "jarvis-desktop-assistant",
  "version": "0.1.0",
  "description": "Jarvis — a glassmorphism desktop AI assistant with a reactive 3D particle orb, voice, weather, tasks/reminders, music and more.",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "build": "node ./scripts/build.js",
    "web": "node server.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-store": "^8.2.0",
    "express": "^4.19.2"
  },
  "optionalDependencies": {
    "whatsapp-web.js": "^1.23.0",
    "qrcode": "^1.5.3",
    "yt-search": "^2.10.4"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.jarvis.assistant",
    "productName": "Jarvis",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ]
  }
}
