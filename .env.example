# Jarvis environment variables.
# Copy this file to ".env" (same folder) and fill in your key.
# The .env file is gitignored — it is NEVER committed or sent to the browser.

# NVIDIA-hosted OpenAI GPT-OSS-120B API key (build.nvidia.com → your model → Get API Key)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: change the port the local server runs on (default 4321)
# JARVIS_PORT=4321
